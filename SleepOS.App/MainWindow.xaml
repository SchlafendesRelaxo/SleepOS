<Window x:Class="SleepOS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SleepOS.App"
        Title="SleepOS" Height="900" Width="1380" MinHeight="700" MinWidth="1000"
        Background="{DynamicResource BackgroundBrush}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <local:ExecutableIconConverter x:Key="ExecutableIconConverter"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#09090D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111119"/>
        <SolidColorBrush x:Key="CardBrush" Color="#15151F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#282835"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9696A5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A855F7"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#79A8FF"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="#101017"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0E0E14"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#1B1B27"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#343444"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#29263A"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#39244F"/>
        <SolidColorBrush x:Key="ListBrush" Color="#101018"/>
        <SolidColorBrush x:Key="HeroBorderBrush" Color="#3D4E78"/>
        <SolidColorBrush x:Key="HeroSubtitleBrush" Color="#B6B4C4"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#B5090C15"/>
        <SolidColorBrush x:Key="CommandSurfaceBrush" Color="#11131D"/>
        <SolidColorBrush x:Key="CommandBorderBrush" Color="#536D9A"/>
        <SolidColorBrush x:Key="CommandSearchBorderBrush" Color="#39496D"/>
        <SolidColorBrush x:Key="CommandItemBrush" Color="#151925"/>
        <SolidColorBrush x:Key="CommandItemHoverBrush" Color="#202A42"/>
        <SolidColorBrush x:Key="CommandItemSelectedBrush" Color="#1B2131"/>
        <SolidColorBrush x:Key="CommandHintBrush" Color="#91B4FF"/>
        <SolidColorBrush x:Key="ReviewBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#351B2A"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#74334D"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FFD1DC"/>
        <SolidColorBrush x:Key="DashboardTagBrush" Color="#243552"/>
        <SolidColorBrush x:Key="DashboardTagBorderBrush" Color="#425D87"/>
        <SolidColorBrush x:Key="DashboardMetaBrush" Color="#171C2A"/>
        <SolidColorBrush x:Key="DashboardMetaBorderBrush" Color="#303A55"/>
        <SolidColorBrush x:Key="OrbitBrush" Color="#465B91"/>
        <SolidColorBrush x:Key="OrbitAccentBrush" Color="#7555A9"/>
        <Color x:Key="AccentColor">#A855F7</Color>
        <Color x:Key="AccentBlueColor">#79A8FF</Color>
        <Color x:Key="HeroStartColor">#1C2A4A</Color>
        <Color x:Key="HeroMiddleColor">#211B3B</Color>
        <Color x:Key="HeroEndColor">#121821</Color>
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#251F33"/>
        <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="#4A3664"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="{DynamicResource AccentBlueColor}" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource HeroStartColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource HeroMiddleColor}" Offset="0.58"/>
                        <GradientStop Color="{DynamicResource HeroEndColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource HeroBorderBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverGlow" Margin="-2" Background="Transparent"
                                    BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="12" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="{DynamicResource AccentBlueColor}" Opacity="0.38"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Border x:Name="ActiveMarker" Width="3" Height="22" Margin="5,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource AccentBlueColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SleepOSComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SleepOSComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SleepOSComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <Grid>
                                        <ContentPresenter IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource ControlBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="Content"
                                              Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Visibility="Collapsed"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              ClipToBounds="True"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="18" ClipToBounds="True" SizeChanged="WindowFrame_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                        <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentBlueColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="32" Height="32">
                                    <Path Data="M 22,3 C 13,4 7,11 7,20 C 7,27 13,30 22,29 C 16,26 13,22 13,17 C 13,11 16,6 22,3 Z"
                                          Fill="#F5F0FF"/>
                                    <Path Data="M 25,4 L 26.4,8.4 L 31,10 L 26.4,11.5 L 25,16 L 23.5,11.5 L 19,10 L 23.5,8.4 Z"
                                          Fill="{DynamicResource AccentBlueBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="SleepOS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="  /  Gaming suite" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button Width="92" Height="30" Padding="0" Content="⌕  Ctrl+K"
                                Click="CommandCenter_Click" ToolTip="Open command center"
                                Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
                        <Button Width="36" Height="30" Padding="0" Content="—" Click="MinimizeWindow" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
                        <Button Width="36" Height="30" Padding="0" Content="□" Click="ToggleWindowState" Style="{StaticResource ActionButton}" Margin="0,0,7,0"/>
                        <Button Width="36" Height="30" Padding="0" Content="×" Click="CloseWindow" Style="{StaticResource ActionButton}"
                                Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="18,26,18,14">
                            <TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"
                                       Margin="12,0,0,12"/>
                            <Button x:Name="DashboardNav" Style="{StaticResource NavButton}"
                                    Click="Dashboard_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OptimizerNav" Style="{StaticResource NavButton}"
                                    Click="Optimizer_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE1E0;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Optimizer"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TweaksNav" Style="{StaticResource NavButton}"
                                    Click="Tweaks_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="SleepOS tweaks"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GamesNav" Style="{StaticResource NavButton}"
                                    Click="Games_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Games &amp; processes"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HardwareNav" Style="{StaticResource NavButton}"
                                    Click="Hardware_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE772;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Hardware center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NetworkNav" Style="{StaticResource NavButton}"
                                    Click="Network_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE701;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Network analyzer"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ProcessNav" Style="{StaticResource NavButton}"
                                    Click="Process_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Background apps"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CareNav" Style="{StaticResource NavButton}"
                                    Click="Care_Click" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="PC care"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}"
                                    Click="Settings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Settings"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="16,16" Padding="14">
                            <StackPanel>
                                <TextBlock Text="SYSTEM STATUS" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SystemStatus}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding ActivePowerProfile}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TabControl x:Name="MainPages" Grid.Column="1" SelectedIndex="0" Style="{StaticResource PageTabs}">
                    <TabItem x:Name="DashboardPage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,18">
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="{DynamicResource DashboardTagBrush}" BorderBrush="{DynamicResource DashboardTagBorderBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="9,5" Margin="0,0,8,0">
                                                    <TextBlock Text="SLEEPOS  /  PC CONTROL" Foreground="{DynamicResource AccentBlueBrush}"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="{DynamicResource DashboardMetaBrush}" BorderBrush="{DynamicResource DashboardMetaBorderBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="9,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBlueBrush}"
                                                                 Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Your PC. Ready for play." Foreground="{DynamicResource TextBrush}"
                                                       FontSize="30" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Greeting}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="13" Margin="0,7,0,0"/>
                                            <Button Content="Explore Optimizer" Style="{StaticResource ActionButton}"
                                                    Click="Optimizer_Click" HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" Margin="0,16,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="170" Height="160"
                                              HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="146" Height="146" Stroke="{DynamicResource OrbitBrush}" StrokeThickness="1"
                                                     Opacity="0.65"/>
                                            <Ellipse Width="118" Height="118" Stroke="{DynamicResource OrbitAccentBrush}" StrokeThickness="1"
                                                     Opacity="0.65"/>
                                            <Ellipse x:Name="HeroCore" Width="88" Height="88">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="{DynamicResource AccentBlueColor}" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.58"/>
                                                        <GradientStop Color="{DynamicResource HeroEndColor}" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="{DynamicResource AccentBlueColor}" Opacity="0.52"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Viewbox Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="32" Height="32">
                                                    <Path Data="M 22,3 C 13,4 7,11 7,20 C 7,27 13,30 22,29 C 16,26 13,22 13,17 C 13,11 16,6 22,3 Z"
                                                          Fill="{DynamicResource TextBrush}"/>
                                                    <Path Data="M 25,4 L 26.4,8.4 L 31,10 L 26.4,11.5 L 25,16 L 23.5,11.5 L 19,10 L 23.5,8.4 Z"
                                                          Fill="{DynamicResource AccentBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <Canvas x:Name="HeroOrbit" Width="170" Height="160"
                                                    RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                                <Canvas.RenderTransform>
                                                    <RotateTransform/>
                                                </Canvas.RenderTransform>
                                                <Ellipse Width="9" Height="9" Canvas.Left="80.5" Canvas.Top="2"
                                                         Fill="{DynamicResource AccentBlueBrush}"
                                                         Stroke="{DynamicResource TextBrush}" StrokeThickness="1"/>
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding HardwareCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" MinHeight="116">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="26" FontWeight="Bold" Margin="0,12,0,3"/>
