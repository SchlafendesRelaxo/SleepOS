                                                            <Run Text=" • Uninspected "/>
                                                            <Run Text="{Binding UninspectedProcessCount}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Capture reading" Style="{StaticResource ActionButton}"
                                                Command="{Binding CapturePerformanceBenchmarkCommand}" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" MinHeight="286">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="20" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding PlanName}" Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,12,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="What changes" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                                    <TextBlock Text="{Binding ChangeSummary}" Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Trade-off" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                                    <TextBlock Text="{Binding ExpectedImpact}" Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" TextWrapping="Wrap"/>
                                                    <Button Content="Switch Windows to this plan" Style="{StaticResource ActionButton}"
                                                            Margin="0,16,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Name}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Latest action" Style="{StaticResource SectionTitle}" FontSize="16"/>
                                        <ItemsControl ItemsSource="{Binding RecentOptimizations}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TweaksPage">
