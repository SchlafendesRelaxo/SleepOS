                                            <TextBlock Text="Uses EcoQoS only for explicitly managed, visible apps after their own inactivity delay and when the selected profile's CPU or memory threshold is reached."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding AutomaticMemorySaverEnabled, StringFormat=Toggle (currently {0})}"
                                                Style="{StaticResource ActionButton}" Command="{Binding ToggleAutomaticMemorySaverCommand}"/>
