                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Game performance profiles" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="{Binding GameProfileStatus}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,10"/>
                                        <ItemsControl ItemsSource="{Binding GameProcessProfiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ListBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <CheckBox Content="{Binding ProcessName}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                          Style="{StaticResource ProcessCheckBox}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}"
                                                                           FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"
                                                                           Margin="22,3,8,0"/>
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="1" Width="150" Style="{StaticResource SleepOSComboBox}"
                                                                      ItemsSource="{Binding DataContext.GamePerformanceModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding PerformanceMode, Mode=TwoWay}"/>
                                                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource ActionButton}"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.RemoveGameProcessProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Save game profiles" Style="{StaticResource ActionButton}"
                                                Command="{Binding SaveGameProfilesCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Top processes by memory" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <ListView ItemsSource="{Binding RunningProcesses}" Background="Transparent"
                                                  BorderThickness="0" Margin="0,10,0,0">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Padding" Value="8,5"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessId, StringFormat=PID {0}}"
                                                                   Foreground="{DynamicResource MutedBrush}" Margin="16,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat={}{0:F1} MB}"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding CpuUsageText}"
                                                                   Foreground="{DynamicResource MutedBrush}" Margin="14,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Priority, StringFormat={}{0} priority}"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="ProcessPage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="PERFORMANCE  /  BACKGROUND APPS" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Clear the noise." Foreground="{DynamicResource TextBrush}"
                                                       FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock Text="Hidden background apps are highlighted for review. Memory use alone never makes an app a candidate."
                                                       Foreground="{DynamicResource HeroSubtitleBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Scan apps" Style="{StaticResource ActionButton}"
                                                Command="{Binding ScanStoppableProcessesCommand}" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Padding="20,12"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Smart Memory Saver" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="{Binding MemorySaverStatus}" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="EcoQoS reduces CPU/power scheduling for opted-in inactive apps; it does not force-release allocated RAM. SleepOS never suspends or terminates apps for Memory Saver."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                            <Button Content="Add selected apps" Style="{StaticResource ActionButton}"
                                                    Command="{Binding AddSelectedToMemorySaverCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Save rules" Style="{StaticResource ActionButton}"
                                                    Command="{Binding SaveMemorySaverRulesCommand}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ManagedApplications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ListBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <CheckBox Content="{Binding ProcessName}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                          Style="{StaticResource ProcessCheckBox}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}"
                                                                           FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"
                                                                           Margin="22,3,8,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="Idle after" Foreground="{DynamicResource MutedBrush}"
                                                                       VerticalAlignment="Center" Margin="8,0"/>
                                                            <ComboBox Grid.Column="2" Width="76" Style="{StaticResource SleepOSComboBox}"
                                                                      ItemsSource="{Binding DataContext.MemorySaverInactivityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding InactivityMinutes, Mode=TwoWay}"/>
                                                            <Button Grid.Column="3" Content="Remove" Style="{StaticResource ActionButton}"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.RemoveMemorySaverRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="App processes" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding ManageableProcessCount, StringFormat={}{0:N0} found}"
                                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding RecommendedProcessCount, StringFormat={}{0:N0} to review}"
                                                           Foreground="{DynamicResource ReviewBrush}" FontSize="11" TextAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                <TextBlock Text="Windows-folder processes, Windows services, SleepOS, visible apps, and recognized active games are not suggested. All other hidden apps are listed for review; a hidden process may still be required by another app."
                                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Rows include description, publisher metadata, path, PID, CPU, RAM, and priority. RAM does not affect suggestions. Stop selected closes only those PIDs; unsaved work may be lost."
                                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ListView ItemsSource="{Binding ManageableProcesses}" Background="{DynamicResource ListBrush}"
                                                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                  MaxHeight="390" MinHeight="90">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Padding" Value="8,7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Width="32" Height="32" Margin="2,0,10,0"
                                                               Source="{Binding ExecutablePath, Converter={StaticResource ExecutableIconConverter}}"/>
                                                        <StackPanel Grid.Column="1" ToolTip="{Binding ExecutablePath}">
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Style="{StaticResource ProcessCheckBox}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ProductDescription, StringFormat=File info: {0}}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" Margin="22,3,12,0"/>
                                                            <TextBlock Text="{Binding Publisher, StringFormat=Publisher metadata (not verified): {0}}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" Margin="22,2,12,0"/>
                                                            <TextBlock Text="{Binding Recommendation}" FontSize="10" FontWeight="SemiBold"
                                                                       Margin="22,3,12,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSuggestedForReview}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ReviewBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding RecommendationDetails}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" Margin="22,2,12,0"/>
                                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"
                                                                       Margin="22,3,12,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding ProcessId, StringFormat=PID {0}}"
                                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding MemoryMb, StringFormat={}{0:F1} MB}"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" MinWidth="72"
                                                                   TextAlignment="Right"/>
                                                        <StackPanel Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CpuUsageText}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                            <TextBlock Text="{Binding Priority, StringFormat=Priority {0}}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                            <TextBlock Text="{Binding WindowActivity}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Text="Tick the app checkboxes above, then choose an action. EcoQoS and priority affect CPU scheduling; Trim selected RAM requests a temporary working-set trim."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,4"/>
                                        <TextBlock Text="{Binding ProcessManagementStatus}" Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button Content="Add selected to game profiles" Style="{StaticResource ActionButton}"
                                                    Command="{Binding AddSelectedToGameProfilesCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Apply EcoQoS" Style="{StaticResource ActionButton}"
                                                    Command="{Binding ApplyEfficiencyModeToSelectedCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Restore policy" Style="{StaticResource ActionButton}"
                                                    Command="{Binding RestoreEfficiencyModeForSelectedCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Set BelowNormal priority" Style="{StaticResource ActionButton}"
                                                    Command="{Binding SetSelectedProcessesToBelowNormalCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Restore priority" Style="{StaticResource ActionButton}"
                                                    Command="{Binding RestoreSelectedProcessPrioritiesCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Trim selected RAM" Style="{StaticResource ActionButton}"
                                                    Click="TrimSelectedProcessesMemory_Click" Margin="0,0,8,8"/>
                                            <Button Content="Stop selected" Style="{StaticResource ActionButton}"
                                                    Click="StopSelectedProcesses_Click" Background="{DynamicResource DangerBrush}"
                                                    BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="{DynamicResource DangerTextBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="HardwarePage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="HARDWARE CENTER  /  WINDOWS INVENTORY" Foreground="{DynamicResource AccentBlueBrush}"
                                                       FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Know your setup." Foreground="{DynamicResource TextBrush}"
                                                       FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock Text="Read-only hardware details reported by Windows. Unsupported sensors and unavailable fields stay clearly marked."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Scan hardware" Style="{StaticResource ActionButton}"
                                                Command="{Binding ScanHardwareCommand}" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" Padding="20,12"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HardwareInventoryStatus}" Foreground="{DynamicResource AccentBlueBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding HardwareInventory}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                                                            Padding="0,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBlueBrush}"
                                                                       FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Details}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="11" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Unavailable or incomplete data"
                                                   Style="{StaticResource SectionTitle}" FontSize="16"/>
                                        <ItemsControl ItemsSource="{Binding HardwareInventoryWarnings}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Windows does not report every sensor or monitor capability. This page does not estimate temperatures, fan speeds, display refresh rates, or drive health."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="NetworkPage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="NETWORK CENTER  /  ON-DEMAND DIAGNOSTICS" Foreground="{DynamicResource AccentBlueBrush}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Know your connection." Foreground="{DynamicResource TextBrush}"
                                                   FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="SleepOS sends five small ICMP probes only after you enter a target and start a test. It does not change DNS, TCP, or registry settings."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,16"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,10,8">
                                                <TextBlock Text="Target host (IP address or host name)" Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding NetworkPingTarget, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="250" Height="40" Padding="10,8"
                                                         Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" CaretBrush="{DynamicResource AccentBlueBrush}"
                                                         ToolTip="No ping test runs until you click Start ping test."/>
                                            </StackPanel>
                                            <Button Content="Start ping test" Style="{StaticResource ActionButton}"
                                                    Command="{Binding RunNetworkPingTestCommand}" Background="{DynamicResource AccentBrush}"
                                                    BorderBrush="{DynamicResource AccentBlueBrush}" Margin="0,20,8,8"/>
                                            <Button Content="Scan adapters" Style="{StaticResource ActionButton}"
                                                    Command="{Binding ScanNetworkAdaptersCommand}" Margin="0,20,0,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="AVERAGE PING" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NetworkAverageText}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="JITTER" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NetworkJitterText}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="PACKET LOSS" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NetworkPacketLossText}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="LIVE THROUGHPUT" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NetworkThroughputStatus}" Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NetworkPingStatus}" Foreground="{DynamicResource AccentBlueBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding NetworkPingSamples}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Sequence, StringFormat=Probe {0}}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                                            <TextBlock Text="{Binding RoundtripDisplay}"
                                                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Network adapters" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                                <TextBlock Text="{Binding NetworkAdapterStatus}" Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding NetworkAdapterWarnings}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource ReviewBrush}"
                                                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding NetworkAdapters}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                                                            Padding="0,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedBrush}"
                                                                           FontSize="10" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                                <TextBlock Text="{Binding Addresses, StringFormat=Addresses: {0}}"
                                                                           Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Gateway, StringFormat=Gateway: {0}}"
                                                                           Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding DnsServers, StringFormat=DNS: {0}}"
                                                                           Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBlueBrush}"
                                                                           FontSize="10" FontWeight="SemiBold" TextAlignment="Right"/>
                                                                <TextBlock Text="{Binding LinkSpeed}" Foreground="{DynamicResource MutedBrush}"
                                                                           FontSize="10" TextAlignment="Right" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Recent tests" Style="{StaticResource SectionTitle}" FontSize="16"/>
                                        <TextBlock Text="Results are kept in memory for this SleepOS session only."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,6"/>
                                        <ItemsControl ItemsSource="{Binding NetworkPingHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0">
                                                        <Run Text="{Binding TestedAt, StringFormat={}{0:t}}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding Target}"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding AverageMilliseconds, StringFormat={}{0:F1} ms avg}"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding PacketLossPercent, StringFormat={}{0:F0}% loss}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="ICMP replies can be blocked or deprioritized by a router, firewall, or host. Ping results do not guarantee the route or latency to a specific game server. Throughput comes from Windows interface counters, not an internet speed test."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="2,12,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="SettingsPage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <TextBlock Text="Settings" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Personalize the look and a few app behaviors. Preferences are stored locally on this PC."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,22"/>
                                <TextBlock Text="APPEARANCE" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           FontWeight="Bold" Margin="2,0,0,10"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Color mode" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Switch between a dark and a light interface."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="140" Style="{StaticResource SleepOSComboBox}"
                                                  ItemsSource="{Binding ColorModeOptions}"
                                                  SelectedItem="{Binding ColorMode, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Accent color" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Choose the highlight color used across SleepOS."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="140" Style="{StaticResource SleepOSComboBox}"
                                                  ItemsSource="{Binding AccentThemeOptions}"
                                                  SelectedItem="{Binding AccentTheme, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SleepOS motion" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PageAnimationsStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Toggle" Style="{StaticResource ActionButton}"
                                                Command="{Binding TogglePageAnimationsCommand}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="BEHAVIOR" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           FontWeight="Bold" Margin="2,0,0,10"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SleepOS performance mode" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PerformanceModeStatus}" Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="150" Style="{StaticResource SleepOSComboBox}"
                                                  ItemsSource="{Binding PerformanceModeOptions}"
                                                  SelectedItem="{Binding PerformanceMode, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Metrics refresh interval" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="How often SleepOS checks system readings while automatic refresh is on."
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="74" Margin="0,0,8,0"
                                                  Style="{StaticResource SleepOSComboBox}"
                                                  ItemsSource="{Binding MetricsRefreshOptions}"
                                                  SelectedItem="{Binding MetricsRefreshSeconds, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="2" Text="seconds" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Automatic refresh" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AutoRefreshStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Toggle" Style="{StaticResource ActionButton}"
                                                Command="{Binding ToggleAutoRefreshCommand}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="WINDOWS SIGN-IN" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           FontWeight="Bold" Margin="2,8,0,10"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Start SleepOS with Windows" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StartupStatus}" Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding AutoStartEnabled, StringFormat=Toggle (currently {0})}"
                                                    Style="{StaticResource ActionButton}" Command="{Binding ToggleAutoStartCommand}"/>
                                        </Grid>
                                        <CheckBox Content="Start minimized in the system tray" IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}" Margin="0,16,0,10"/>
                                        <Grid IsEnabled="{Binding IsStartupDelayEnabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Startup delay" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Delay the launch after Windows sign-in to reduce startup contention."
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,12,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="92" Style="{StaticResource SleepOSComboBox}"
                                                      ItemsSource="{Binding StartupDelayOptions}"
                                                      SelectedItem="{Binding StartupDelaySeconds, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="SleepOS updates" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,5,0,10"/>
                                        <Button Content="Check and install update" Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Left" Command="{Binding UpdateAppCommand}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="About SleepOS" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="{Binding ActiveVersion, StringFormat=Version {0}}"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                                        <TextBlock Text="{Binding ActionStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid x:Name="CommandCenterOverlay" Grid.RowSpan="2" Panel.ZIndex="20"
                  Visibility="Collapsed" Background="{DynamicResource OverlayBrush}"
                  MouseLeftButtonDown="CommandCenterOverlay_MouseLeftButtonDown">
                <Border Width="650" MaxHeight="560" Margin="0,82,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="{DynamicResource CommandSurfaceBrush}" BorderBrush="{DynamicResource CommandBorderBrush}" BorderThickness="1"
                        CornerRadius="18" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="{DynamicResource AccentBlueColor}" Opacity="0.28"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="COMMAND CENTER  /  CTRL + K" Foreground="{DynamicResource AccentBlueBrush}"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Where do you want to go?" Foreground="{DynamicResource TextBrush}"
                                   FontSize="22" FontWeight="Bold" Margin="0,6,0,14"/>
                        <TextBox x:Name="CommandSearchBox" AutomationProperties.Name="Search commands"
                                 TextChanged="CommandSearchBox_TextChanged"
                                 Height="44" Padding="12,10" Background="{DynamicResource ControlBrush}"
                                 Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CommandSearchBorderBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 ToolTip="Search available pages and safe actions."/>
                        <ListBox x:Name="CommandResultsList" MaxHeight="390" Margin="0,12,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 MouseDoubleClick="CommandResultsList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CommandItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CommandItemSelectedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CommandItemBrush}" BorderBrush="{DynamicResource CommandBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="12" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,3,10,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="ENTER" Foreground="{DynamicResource AccentBlueBrush}"
                                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="CommandNoResults" Text="No matching commands."
                                   Foreground="{DynamicResource MutedBrush}" Margin="2,14,0,0"
                                   Visibility="Collapsed"/>
                        <TextBlock Text="Enter to run  •  Tab to results  •  Esc to close"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="2,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
