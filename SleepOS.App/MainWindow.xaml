                                        <TextBlock Text="{Binding DesktopShortcutStatus}" Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <ListView ItemsSource="{Binding DuplicateDesktopShortcuts}" MaxHeight="220"
                                                  Background="{DynamicResource ListBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                  Foreground="{DynamicResource TextBrush}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                                                  Margin="0,3,10,0" Style="{StaticResource ProcessCheckBox}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding TargetPath}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Arguments, StringFormat=Arguments: {0}}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding ShortcutPath}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <ItemsControl ItemsSource="{Binding DesktopShortcutWarnings}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Temporary files" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="SleepOS scans only your local Temp folder and recommends files last changed more than 30 days ago. Downloads, documents, Recycle Bin, and Windows system folders are not included."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Scan for safe cleanup" Style="{StaticResource ActionButton}"
                                                    Command="{Binding ScanTemporaryFilesCommand}" Margin="0,0,10,0"/>
                                            <Button Content="Clean recommended files" Style="{StaticResource ActionButton}"
                                                    Command="{Binding CleanTemporaryFilesCommand}" IsEnabled="{Binding CanCleanTemporaryFiles}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CleanupStatus}" Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Windows maintenance" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="Updates and system-level changes stay in Windows. SleepOS opens the relevant page; you review and confirm any installation or setting change there."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                        <WrapPanel>
                                            <Button Content="Open Windows Update" Style="{StaticResource ActionButton}"
                                                    Command="{Binding OpenWindowsUpdateSettingsCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Open Storage settings" Style="{StaticResource ActionButton}"
                                                    Command="{Binding OpenWindowsStorageSettingsCommand}" Margin="0,0,8,8"/>
                                            <Button Content="Open Power settings" Style="{StaticResource ActionButton}"
                                                    Command="{Binding OpenWindowsPowerSettingsCommand}" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Current Windows power plan" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding ActivePowerProfile}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding ActionStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="OptimizerPage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
