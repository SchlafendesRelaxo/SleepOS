                                                    <DataTemplate>
                                                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0">
                                                            <Run Text="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                                            <Run Text=" • CPU "/>
                                                            <Run Text="{Binding CpuUsagePercent, StringFormat={}{0:F1}%}"/>
                                                            <Run Text=" • RAM "/>
                                                            <Run Text="{Binding RamUsedGb, StringFormat={}{0:F2} GB}"/>
