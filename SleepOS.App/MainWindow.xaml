                                                    Command="{Binding RestartExplorerCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="CarePage">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{DynamicResource BackgroundBrush}">
                            <StackPanel Margin="30,28,30,34">
                                <TextBlock Text="PC care" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Review safe cleanup recommendations and open official Windows maintenance settings."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,22"/>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Duplicate browser tabs" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="Use the included SleepOS Duplicate Tabs browser extension for Edge, Chrome, or Firefox. It previews tabs with the same title and address, keeps one copy, and asks before closing selected tabs."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="The browser extension is installed separately by the user; SleepOS does not read or close tabs in the background."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Duplicate Desktop shortcuts" Style="{StaticResource SectionTitle}" FontSize="17"/>
                                        <TextBlock Text="Scans .lnk shortcuts on your personal and shared Desktop for identical targets. It never removes the app or file itself; selected shortcut links go to the Recycle Bin after confirmation."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
